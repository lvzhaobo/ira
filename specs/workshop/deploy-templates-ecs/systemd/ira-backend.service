[Unit]
Description=IRA Backend (Gunicorn)
After=network.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__APP_ROOT__/ira/backend
EnvironmentFile=__APP_ROOT__/.env
ExecStart=__APP_ROOT__/.venv/bin/gunicorn -c __APP_ROOT__/specs/workshop/deploy-templates-ecs/gunicorn/gunicorn.conf.py wsgi:app
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM

# 最小安全加固
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
