# ===== 基础 =====
APP_ENV=production
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# ===== 路径 =====
IRA_DATA_DIR=__APP_ROOT__/data

# ===== Web / API =====
IRA_BACKEND_HOST=0.0.0.0
IRA_BACKEND_PORT=__BACKEND_PORT__
CORS_ALLOW_ORIGINS=https://__DOMAIN__

# ===== 百炼（推荐变量名，与 ira 主项目一致） =====
DASHSCOPE_API_KEY=
IRA_BAILIAN_MODEL=qwen-plus
IRA_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IRA_BAILIAN_TEMPERATURE=0.2

# ===== CoPaw（可选） =====
IRA_COPAW_QA_ASK_URL=
IRA_COPAW_BASE_URL=
IRA_COPAW_API_TOKEN=
IRA_COPAW_TIMEOUT_SEC=20

# ===== 运行配置 =====
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
