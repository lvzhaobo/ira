# ==========================================
# 钉钉企业内部应用配置(推荐)
# ==========================================
# 创建方式: 钉钉开放平台 -> 应用开发 -> 企业内部应用
# 文档: https://open.dingtalk.com/document/orgapp

# 应用凭证(必填)
DINGTALK_APP_KEY=dingxxxxxx你的AppKey
DINGTALK_APP_SECRET=xxxxxxxxxxxxxx你的AppSecret

# 机器人配置(必填)
# 在应用详情 -> 应用能力 -> 机器人 中获取
DINGTALK_ROBOT_CODE=你的机器人Code

# 消息接收地址(配置在钉钉开放平台)
# http://你的ECS_IP:8080/webhook
# 或 https://your-domain.com/webhook

# ========================================== 
# 自定义Webhook机器人配置(简单通知场景)
# ==========================================
# 注意: 自定义机器人只能发送消息,不能接收消息
# 如果需要接收用户指令,请使用上面的企业内部应用

# DINGTALK_SECRET=SECxxxxxx你的钉钉机器人密钥
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxxxx你的钉钉机器人access_token

# Qoder CLI配置
QODER_PERSONAL_ACCESS_TOKEN=你的Qoder Personal Access Token
QODER_WORKDIR=/opt/qoder-workspace

# 服务配置
PORT=8080
NODE_ENV=production

# 安全配置(允许执行Qoder CLI的用户ID列表,逗号分隔)
ALLOWED_DINGTALK_USERS=user123,user456

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log

# 任务配置
MAX_QODER_TURNS=15
QODER_TIMEOUT=300000
MAX_CONCURRENT_TASKS=3

# 通知配置(可选,用于发送执行结果通知)
NOTIFY_ON_COMPLETE=true
NOTIFY_ON_ERROR=true
