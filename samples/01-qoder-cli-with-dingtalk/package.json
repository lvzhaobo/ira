{
  "name": "dingtalk-qoder-bridge",
  "version": "1.0.0",
  "description": "钉钉机器人集成Qoder CLI,通过钉钉消息管理ECS和执行任务",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop dingtalk-qoder",
    "pm2:restart": "pm2 restart dingtalk-qoder",
    "pm2:logs": "pm2 logs dingtalk-qoder",
    "test": "node test/test-basic.js"
  },
  "keywords": [
    "dingtalk",
    "qoder",
    "cli",
    "bridge",
    "ecs",
    "automation"
  ],
  "author": "Workshop Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
