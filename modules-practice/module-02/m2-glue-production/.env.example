# M2 Glue Coding 环境变量配置示例
# 
# 【来源】参考 ira-vin-mocks/README.md 和 Agents.md §Mock 数据源
# 【说明】复制为 .env 并填写实际值

# ============================================================
# Mock 数据源（ira.vin）
# ============================================================

# ira.vin Mock 服务基地址（不含尾部 /）
IRA_VIN_MOCK_BASE=http://127.0.0.1:8099

# 新浪财经 Mock Feed URL
SINA_FEED_URL=${IRA_VIN_MOCK_BASE}/mock/v1/sina/finance/news/list.json

# 东方财富 Mock Feed URL
EASTMONEY_FLASH_URL=${IRA_VIN_MOCK_BASE}/mock/v1/eastmoney/api/news/flash

# Wind 快照 Mock URL（P1 阶段启用）
# WIND_SNAPSHOT_URL=${IRA_VIN_MOCK_BASE}/mock/v1/wind/market/snapshot


# ============================================================
# 数据库（S1 阶段启用）
# ============================================================

# PostgreSQL 连接字符串
# DATABASE_URL=postgresql://user:password@localhost:5432/ira_m2

# ============================================================
# 密钥管理（禁止明文落库）
# ============================================================

# 新浪 API Key（通过 KMS/环境变量注入）
# SINA_API_KEY=your-secret-key

# 东财 API Key
# EASTMONEY_API_KEY=your-secret-key


# ============================================================
# Flask 配置
# ============================================================

FLASK_ENV=development
FLASK_DEBUG=1
